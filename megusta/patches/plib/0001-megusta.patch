+void ssgCompiledLeaf::draw()
+{
+  if(!preDraw())return;
+  if(hasState())getState()->apply();
+  ++stats_num_leaves;
+  stats_num_triangles+=compiled_triangles;
+  stats_num_vertices+=compiled_vertices;
+  if(!dlist)std::abort();
+  glCallList(dlist);
+  if(postDrawCB)postDrawCB(this);
