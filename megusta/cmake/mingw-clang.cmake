set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86)
set(MEGUSTA_MINGW_ROOT "/opt/homebrew/opt/mingw-w64" CACHE PATH "MinGW-w64 installation")
set(MEGUSTA_LLVM_ROOT "/opt/homebrew/opt/llvm@22" CACHE PATH "LLVM installation")
set(CMAKE_C_COMPILER "${MEGUSTA_LLVM_ROOT}/bin/clang")
set(CMAKE_CXX_COMPILER "${MEGUSTA_LLVM_ROOT}/bin/clang++")
set(CMAKE_C_COMPILER_TARGET i686-w64-windows-gnu)
set(CMAKE_CXX_COMPILER_TARGET i686-w64-windows-gnu)
# Homebrew's i686 MinGW libstdc++ uses SJLJ exception handling.
set(CMAKE_CXX_FLAGS_INIT "-fsjlj-exceptions")
set(CMAKE_SYSROOT "${MEGUSTA_MINGW_ROOT}/toolchain-i686")
set(_mingw_ld "${MEGUSTA_MINGW_ROOT}/bin/i686-w64-mingw32-ld")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=${_mingw_ld}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=${_mingw_ld}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
