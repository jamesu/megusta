# External files are runtime data only; no source/include paths escape megusta.
function(megusta_package_assets target)
  if(NOT EMSCRIPTEN OR NOT MEGUSTA_ASSET_DIR)
    return()
  endif()
  if(NOT IS_DIRECTORY "${MEGUSTA_ASSET_DIR}")
    message(FATAL_ERROR "MEGUSTA_ASSET_DIR is not a directory: ${MEGUSTA_ASSET_DIR}")
  endif()
  file(GLOB children CONFIGURE_DEPENDS RELATIVE "${MEGUSTA_ASSET_DIR}" "${MEGUSTA_ASSET_DIR}/*")
  foreach(child IN LISTS children)
    if(child STREQUAL "out")
      continue()
    endif()
    target_link_options(${target} PRIVATE "SHELL:--preload-file \"${MEGUSTA_ASSET_DIR}/${child}@/${child}\"")
    # File edits must regenerate the data package as well as additions/removals.
    if(IS_DIRECTORY "${MEGUSTA_ASSET_DIR}/${child}")
      file(GLOB_RECURSE inputs CONFIGURE_DEPENDS "${MEGUSTA_ASSET_DIR}/${child}/*")
    else()
      set(inputs "${MEGUSTA_ASSET_DIR}/${child}")
    endif()
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS ${inputs})
  endforeach()
  target_link_options(${target} PRIVATE "-sFORCE_FILESYSTEM=1")
endfunction()
